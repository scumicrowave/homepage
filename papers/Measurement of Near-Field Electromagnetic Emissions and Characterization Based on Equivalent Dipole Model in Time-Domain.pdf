         <pdf:Keywords>[Electronic Manuscript]</pdf:Keywords>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>image/epsf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">EuMC 2016 : Stochastic Methods for Complex EMC Systems</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>[Electronic Manuscript]</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:title>
